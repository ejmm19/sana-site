#: lite/includes/Admin/Templates/search-replace.php:53
msgid "ERROR: Something may have gone wrong."
msgstr "ERROR: Puede que algo haya ido mal."

#: lite/includes/Admin/Templates/search-replace.php:64
msgid "Success! Your URLs have been updated."
msgstr "¡Correcto! Tus URL han sido actualizadas."

#: lite/includes/Admin/Templates/search-replace.php:70
msgid "Results"
msgstr "Resultados"

#: lite/includes/Admin/Templates/search-replace.php:83
msgid "Please enter values for both the old url and the new url."
msgstr "Por favor, introduce los valores de la antigua URL y de la nueva URL."

#: lite/includes/Admin/Templates/search-replace.php:97
msgid "After moving a website, %s lets you fix old URLs in content, excerpts, links, and custom fields."
msgstr "Después de mover una web, %s te permite corregir las URL antiguas en el contenido, los extractos, los enlaces y los campos personalizados."

#: lite/includes/Admin/Templates/search-replace.php:98
msgid "WE RECOMMEND THAT YOU BACKUP YOUR WEBSITE."
msgstr "RECOMENDAMOS QUE HAGAS UNA COPIA DE SEGURIDAD DE TU WEB."

#: lite/includes/Admin/Templates/search-replace.php:99
msgid "You may need to restore it if incorrect URLs are entered in the fields below."
msgstr "Puede que tengas que restaurarla si se han introducido URL incorrectas en los siguientes campos."

#: lite/includes/Admin/Templates/search-replace.php:107
msgid "Old URL"
msgstr "URL antigua"

#: lite/includes/Admin/Templates/search-replace.php:129
msgid "New URL"
msgstr "Nueva URL"

#: lite/includes/Admin/Templates/search-replace.php:159
msgid "Choose which URLs should be updated"
msgstr "Elige qué URL deberían ser actualizadas"

#: lite/includes/Admin/Templates/search-replace.php:5
msgid "URLs in excerpts"
msgstr "URL en los extractos"

#: lite/includes/Admin/Templates/search-replace.php:7
msgid "URLs in links"
msgstr "URL en los enlaces"

#: lite/includes/Admin/Templates/search-replace.php:8
msgid "URLs in custom fields and meta boxes"
msgstr "URL en campos personalizados y cajas meta"

#: lite/includes/Admin/Templates/search-replace.php:197
msgid "Update URLs NOW"
msgstr "Actualizar las URL AHORA"

